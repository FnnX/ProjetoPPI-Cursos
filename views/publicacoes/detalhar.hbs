<article class="detalhe">
  <a class="voltar" href="/publicacoes">← Voltar para a lista</a>
  <p class="categoria">carga horária total: {{publicacao.cargaHoraria}}</p>
  <h1>{{publicacao.titulo}}</h1>
  <p class="detalhe__conteudo">{{publicacao.descricao}}</p>
  <footer>
    <span>Por {{publicacao.instrutor}}</span>
    <span>Publicada em {{formatarData publicacao.createdAt}}</span>
  </footer>
</article>
